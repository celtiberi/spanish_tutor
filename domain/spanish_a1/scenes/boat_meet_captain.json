      {
        "id": "captain_name",
        "evidence_any": ["cómo te llamas", "como te llamas", "cómo se llama", "como se llama"]
      },
      {
        "id": "captain_estado",
        "evidence_any": ["cómo estás", "como estas", "cómo está", "como esta"]
      }
    ]
  },
  "tutor_private_info": {
    "captain_name": "Me llamo Andrés.",
    "captain_estado": "Estoy muy bien, gracias."
  },
  "learner_must_obtain": ["captain_name", "captain_estado"],
  "scope": { "pack": "spanish_a1" },
